<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Local collectors are often plain HTTP; this is a developer tool, not a production client. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
